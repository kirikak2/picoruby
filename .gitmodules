[submodule "mrbgems/picoruby-mrubyc/lib/mrubyc"]
	path = mrbgems/picoruby-mrubyc/lib/mrubyc
	url = https://github.com/mrubyc/mrubyc
[submodule "mrbgems/picoruby-mruby/lib/mruby"]
	path = mrbgems/picoruby-mruby/lib/mruby
	url = https://github.com/mruby/mruby.git
[submodule "mrbgems/picoruby-mruby/lib/estalloc"]
	path = mrbgems/picoruby-mruby/lib/estalloc
	url = https://github.com/picoruby/estalloc
[submodule "mrbgems/mruby-compiler2"]
	path = mrbgems/mruby-compiler2
	url = https://github.com/picoruby/mruby-compiler2
[submodule "mrbgems/mruby-bin-mrbc2"]
	path = mrbgems/mruby-bin-mrbc2
	url = https://github.com/picoruby/mruby-bin-mrbc2
[submodule "mrbgems/picoruby-r2p2/lib/pico-sdk"]
	path = mrbgems/picoruby-r2p2/lib/pico-sdk
	url = https://github.com/raspberrypi/pico-sdk.git
	ignore = dirty
[submodule "mrbgems/picoruby-r2p2/lib/pico-extras"]
