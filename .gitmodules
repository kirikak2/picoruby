[submodule "mrbgems/picoruby-regexp_light/lib/regex_light"]
	path = mrbgems/picoruby-regexp_light/lib/regex_light
	url = https://github.com/hasumikin/regex_light
[submodule "mrbgems/picoruby-littlefs/lib/littlefs"]
	path = mrbgems/picoruby-littlefs/lib/littlefs
	url = https://github.com/littlefs-project/littlefs
[submodule "mrbgems/picoruby-funicular"]
	path = mrbgems/picoruby-funicular
	url = https://github.com/picoruby/funicular
[submodule "mrbgems/picoruby-uart_midi"]
	path = mrbgems/picoruby-uart_midi
